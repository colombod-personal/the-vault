# Copy to .env for local development. Every OAuth provider is optional: a provider
# shows up on the sign-in screen only when its client id is set.

DATABASE_URL=postgresql://vault:vault@localhost:5432/vault   # Postgres only; Neon: postgres://user:pass@host/db?sslmode=require
SESSION_SECRET=change-me-to-a-long-random-string
BASE_URL=http://localhost:8000             # public origin, used to build OAuth redirect URIs
DEV_LOGIN=1                                # local only: enables POST /api/auth/dev-login

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=                       # Entra app registration, "personal + work/school accounts"
MICROSOFT_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v23.0
# AUTH_HIDDEN_PROVIDERS=facebook          # configured but not offered on the sign-in screen (e.g. a Meta app still in Development mode)

APPLE_CLIENT_ID=                           # the Services ID, e.g. com.example.vault.web
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=                         # contents of the .p8 key; literal \n are accepted

# Native iOS app (optional)
APPLE_APP_BUNDLE_ID=                       # e.g. com.example.vault (audience of native Sign in with Apple tokens)
GOOGLE_IOS_CLIENT_ID=                      # the iOS OAuth client id from Google Cloud
APP_REDIRECT_URIS=vault://auth             # where browser sign-ins hand over to the app

# Serious account actions (delete, export, a token, adding or removing a sign-in method) need a sign-in this recent, in seconds (60 to 3600)
# RECENT_SIGNIN_SECONDS=600
# E-mailed confirmation code (vault/email.py): inert until RESEND_API_KEY is set; the sending domain must be verified at Resend
# RESEND_API_KEY=
# EMAIL_FROM=The Vault <login@mtgvault.cards>
# APPLE_RELAY_REGISTERED=0                # 1 once the sending domain is registered for Apple's private relay (Sign in with Apple for Email Communication)
# EMAIL_DAILY_CAP=90                       # all mails of the Vault in a day (Resend's free plan allows 100)

# Sign-in rate limits, per client IP and endpoint per minute (docs/api.md -> Rate limits; optional)
# AUTH_RATE_LIMIT=30
# AUTH_VERIFY_RATE_LIMIT=10
# Server price refreshes (POST /api/v1/collection/refresh) per user per minute (optional)
# REFRESH_RATE_LIMIT=20
# LOOKUP_REFRESH_LIMIT=20  ARCHIDEKT_LIMIT=30  IMPORT_LIMIT=10  LAB_LIMIT=120 (per person per minute); ARCHIDEKT_INTERVAL=1.0 seconds; MAX_DECKS=200

# Local development without real services: run `python -m twins --port 9000` and set
# VAULT_TWINS_URL=http://localhost:9000   (docs/twins.md; refused on https / Vercel)

# OAuth for MCP clients (optional): requests per minute per IP, registrations per minute, and how many
# registered clients may exist at once
# OAUTH_RATE_LIMIT=120
# OAUTH_REGISTER_RATE_LIMIT=20
# OAUTH_CLIENT_CAP=2000
# OAUTH_CIMD_CAP=5000
# OAUTH_FETCH_LIMIT=60
# OAUTH_FETCH_IP_LIMIT=10
